# Baked into the httpsms-web image by .github/workflows/docker-images.yml.
# Edit, commit, push to main -> the workflow rebuilds the web image.
#
# Every value here ends up in the browser bundle, so nothing secret belongs here.
# The Firebase service-account JSON goes in the API container's FIREBASE_CREDENTIALS on Unraid.

# Where the browser reaches the API and the web UI
API_BASE_URL=http://UNRAID-IP:8000
APP_URL=http://UNRAID-IP:3000

APP_NAME=httpSMS
APP_ENV=production
APP_GITHUB_URL=https://github.com/NdoleStudio/httpsms
APP_DOCUMENTATION_URL=https://docs.httpsms.com
APP_DOWNLOAD_URL=https://github.com/NdoleStudio/httpsms/releases/latest/download/HttpSms.apk

# Firebase web app config: Firebase console -> Project settings -> Your apps -> Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional: captcha on the search-messages page
CLOUDFLARE_TURNSTILE_SITE_KEY=

# Optional: realtime updates (leave empty to disable)
PUSHER_KEY=
PUSHER_CLUSTER=
